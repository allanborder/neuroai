# ── NeuroAI Backend Environment Variables ──
# Copy to .env for local overrides (never commit actual secrets)

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & CORS
# In production, set to your Vercel frontend origin, e.g. https://neuroai-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Configuration
MODEL_PATH=./brain_tumor_model.h5
MAX_UPLOAD_SIZE_MB=10

# LLM Diagnostic Report Provider
# Supported: 'mistral' (recommended for cloud), 'ollama' (local default), 'openai_compatible'
LLM_PROVIDER=mistral

# Mistral AI Cloud API (Required if LLM_PROVIDER=mistral)
# Obtain from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest

# Ollama Endpoint (Used if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# OpenAI-Compatible Endpoint (Optional, e.g. Groq, Together, vLLM)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Request Timeout
LLM_TIMEOUT_SECONDS=45.0
